# Copy to .env and fill in. Never commit .env.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ENV=production
MOAGI_SECRET=<random-string-of-32-or-more-characters>
ALLOWED_ORIGINS=https://yourdomain.com
# Optional: restrict accepted Host headers (comma-separated)
TRUSTED_HOSTS=yourdomain.com
DATABASE_URL=postgresql://moagi_app:<password>@localhost:5432/moagi
SEED_DEMO=false
# Only used when SEED_DEMO=true (never in production)
# DEMO_PASSWORD=
# UPLOAD_DIR=/var/lib/moagi/uploads
